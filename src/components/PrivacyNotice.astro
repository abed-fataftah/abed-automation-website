---
// The privacy notice (spec 0007), shown on its own page at /privacy (spec 0014):
// one h2 and paragraph per topic, then the "Last updated" line. Every word comes
// from `site.privacy`; the email parts show `site.footer.email`, so the address
// lives in one place.
import { site } from '@/content/site';

const { updatedLabel, updated, sections } = site.privacy;

// Formatted once at build time, in UTC, so the date never shifts by time zone.
const updatedText = new Date(updated).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<div class="max-w-170">
  {sections.map((section) => (
    <section class="mt-10">
      <h2 class="text-card-title font-semibold">{section.heading}</h2>
      {/* Parts join with no added spaces; set:text keeps link text free of template whitespace. */}
      <p class="mt-3 text-body-lg leading-[1.65] text-muted">
        {section.body.map((part) =>
          typeof part === 'string' ? (
            part
          ) : 'email' in part ? (
            <a
              href={`mailto:${site.footer.email}`}
              class="inline-link"
              set:text={site.footer.email}
            />
          ) : (
            <a href={part.href} class="inline-link" set:text={part.text} />
          ),
        )}
      </p>
    </section>
  ))}
  <p class="mt-10 text-small text-muted">
    {updatedLabel} <time datetime={updated}>{updatedText}</time>
  </p>
</div>
