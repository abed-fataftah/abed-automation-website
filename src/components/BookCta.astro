---
// The only component that renders a booking link. Every "Book a Free Call"
// button uses it, so the URL lives in one place and clicks are counted here:
// Umami's tracker sends the named event, with the button's location, before
// it follows the link (spec 0010). Without the tracker the attributes do nothing.
import { site } from '@/content/site';

interface Props {
  // Where the button sits, so clicks can be told apart. Add a value for a new button.
  location: 'hero' | 'final';
  label?: string;
  class?: string;
}

const { location, label = site.cta.bookLabel, class: className } = Astro.props;
---

<a
  href={site.bookingUrl}
  class:list={['btn-primary', className]}
  data-book-cta
  data-umami-event={site.analytics.bookEvent}
  data-umami-event-location={location}
>
  {label}
</a>
