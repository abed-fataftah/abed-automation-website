---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import { CONTEXT } from 'astro:env/server';
import { site } from '@/content/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = site.meta.title,
  description = site.meta.description,
  noindex = false,
} = Astro.props;

// Count visits only on Netlify's production deploy (spec 0010), so previews,
// local builds, and CI never load the tracker.
const countVisits = CONTEXT === 'production';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-schibsted" preload />
    {countVisits && (
      <script
        is:inline
        defer
        src={site.analytics.scriptUrl}
        data-website-id={site.analytics.websiteId}
        data-domains={site.analytics.domain}
      />
    )}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only rounded-button bg-fg text-body font-bold text-bg focus:not-sr-only focus:fixed focus:top-2 focus:left-4 focus:z-(--z-skip-link) focus:px-4 focus:py-3"
    >
      {site.a11y.skipLink}
    </a>
    <slot name="header" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
    <script>
      import '@/motion/loader';
    </script>
  </body>
</html>
