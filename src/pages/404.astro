---
import Base from '@/layouts/Base.astro';
import BookCta from '@/components/BookCta.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import { site } from '@/content/site';
---

<Base title={site.notFound.title} noindex>
  <SiteHeader slot="header" home="/" />

  <div class="site-wrap pt-hero-top pb-section-y">
    <div class="max-w-170">
      <p class="text-small text-muted">{site.notFound.code}</p>
      <h1 class="mt-4 text-section font-bold">{site.notFound.heading}</h1>
      <p class="mt-4 text-body-lg text-muted">{site.notFound.body}</p>
      <!-- One row from 640px; the button and the link stack below it. -->
      <div class="mt-8 flex flex-col items-start gap-y-3 sm:flex-row sm:items-center sm:gap-x-7">
        <BookCta location="not-found" />
        <a href="/" class="text-link">
          {site.notFound.homeLabel}
        </a>
      </div>
    </div>
  </div>

  <SiteFooter slot="footer" />
</Base>
