# Cloudflare Pages headers (spec 0013). Netlify deletes this file in its build
# commands, so it only ever applies on Cloudflare.
#
# Everything is self hosted except Umami (spec 0010): the script loads from
# cloud.umami.is and posts to gateway.umami.is. Styles allow inline for the
# font face block Astro writes into the head; no script is ever inline.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cloud.umami.is; connect-src 'self' https://gateway.umami.is; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Hashed build files never change, so browsers may cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
