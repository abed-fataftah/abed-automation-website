{
  "name": "abed-automation-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "lint": "astro sync && eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:live": "node scripts/check-live.mjs",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm check:design && pnpm check:copy && pnpm build && pnpm check:seo && pnpm check:bundle",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.3",
    "gsap": "~3.15.0",
    "satori": "^0.63.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "three": "~0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@types/three": "~0.186.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,mjs,astro}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,json,yml,yaml}": "prettier --write"
  }
}
